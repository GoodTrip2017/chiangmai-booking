# Node.js 24。本機用 development；Railway 設 production。
NODE_ENV=development
PORT=3000

# 應用服務必須主動引用資料庫連線；Railway 不會自動替另一個服務注入。
# Railway Variables: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:password@localhost:5432/chiangmai_booking
# Railway 內網 false；需要 TLS 的外部資料庫 true，使用有效憑證。
# 不要在 DATABASE_URL 混用 sslmode、sslrootcert 等參數；正式環境必須明確選擇。
DATABASE_SSL=false
# 自簽／私有 CA 時填 CA 內容（可使用字面 \n），不要停用憑證驗證。
DATABASE_CA_CERT=

# 執行 npm run admin:password 產生，只將雜湊填入；密碼自行保管。
# 格式為 scrypt:16384:8:5:salt:hash；舊雜湊需重新產生。
# 舊 ADMIN_TOKEN 已停用。後台網址固定 /admin。
ADMIN_PASSWORD_HASH=
# 本機可留空；正式環境填 https://你的網域（不含結尾 /）。
# 若未填，正式環境使用 Railway 產生的 RAILWAY_PUBLIC_DOMAIN。
APP_ORIGIN=

# 確認信：Resend HTTPS API，適用 Railway Free／Trial／Hobby／Pro。
# 請使用你已完成寄件網域驗證的地址，例如「品牌名稱 <booking@你的網域>」。
# 留空時仍接受預約，前後台都會顯示確認信未寄出。
RESEND_API_KEY=
MAIL_FROM=
# Optional reply address; may be the store's Gmail while MAIL_FROM uses a verified domain.
MAIL_REPLY_TO=

# LINE 工作群組通知；未設定不推播。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_GROUP_ID=
