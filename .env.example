# PostgreSQL 連線字串（Railway 會自動注入 DATABASE_URL）
DATABASE_URL=postgres://user:password@localhost:5432/chiangmai_booking
# 連線是否走 SSL（Railway 對外連線設 true；內網或本機設 false）
DATABASE_SSL=false

# 服務埠（Railway 會自動注入 PORT）
PORT=3000

# 後台憑證：後台網址 /admin?token=<ADMIN_TOKEN>
# 產生方式：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=change-me

# 確認信 SMTP（留空則不寄信，預約仍會成立）
# Gmail 範例：SMTP_HOST=smtp.gmail.com / SMTP_PORT=465 / SMTP_SECURE=true
# SMTP_USER=你的gmail / SMTP_PASS=應用程式密碼
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# LINE Bot（未設定時推播與 webhook 自動停用）
# LINE Developers 的 Messaging API channel 取得下面兩個值
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 新預約要推播的群組 ID（bot 加入群組時伺服器 log 會印出來）
LINE_GROUP_ID=
